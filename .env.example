# Copie para .env e preencha

# Token do painel de administrador (/admin), onde você envia as calls. Use algo longo e aleatório
ADMIN_TOKEN=troque-por-um-token-longo

# Chave de 64 caracteres hex para criptografar as API keys dos clientes.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# GUARDE UM BACKUP: sem ela as chaves salvas ficam ilegíveis.
ENCRYPTION_KEY=

PORT=3000

# Usa as redes de teste das corretoras (Binance/Bybit testnet). Deixe false em produção.
SANDBOX=false

# Rejeita a entrada se o preço atual estiver mais longe que X% do valor de entrada do sinal
MAX_SLIPPAGE_PCT=0.5

# Se a ordem de stop falhar, fecha a posição a mercado para o cliente não ficar sem proteção
CLOSE_ON_STOP_FAILURE=true

# Intervalo (segundos) do monitor de preços para rompimento, fundo, ordens limite e TP no spot
POLL_SECONDS=5

# Pasta dos dados (clientes e operações). Em hospedagem, use um caminho FORA da pasta do deploy,
# senão um novo deploy pode apagar os dados. Ex.: /home/SEU_USUARIO/bot-data
# DATA_DIR=

# Código de convite exigido no cadastro de usuários. Deixe vazio para cadastro aberto (não recomendado).
INVITE_CODE=troque-pelo-codigo-de-convite
